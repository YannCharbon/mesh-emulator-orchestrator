{
  "format": "wssim-scenario 1",
  "name": "Links of a hop-2 router cut for 120 s",
  "description": "Hand-written phases: a steady load from 300 s; every link of a random hop-2 router cut for 120 s; measurement until the mesh is repaired, then for 120 s after the links are restored.",
  "settings": {"poll_s": 2},
  "phases": [
    {"name": "steady", "start": {"is": "time", "t_s": 300},
     "load": {"flows": ["up", "down"], "interval_s": 20},
     "measure": {"sets": ["traffic", "queues", "mesh"], "settle_s": 30},
     "end": {"after_s": 150}},
    {"name": "cut", "actions": [{"do": "cut_links", "nodes": {"select": "hop", "hop": 2, "pick": "random"}, "for_s": 120, "label": "cut"}],
     "measure": {"sets": ["traffic", "mesh"]},
     "end": {"is": "repaired", "max_s": 300}},
    {"name": "after", "start": {"is": "elapsed", "s": 0},
     "measure": {"sets": ["traffic", "queues", "mesh"]},
     "end": {"is": "all", "of": [{"is": "elapsed", "s": 120}, {"is": "metric", "metric": "pdr", "op": ">=", "value": 0.99, "window_s": 60}], "max_s": 400}}
  ],
  "plots": [
    {"title": "Delivery ratio over time", "x": "t_mid_s", "y": "pdr"},
    {"title": "RTT over time (mean, p95)", "x": "t_mid_s", "y": ["rtt.mean_ms", "rtt.p95_ms"]},
    {"title": "MAC retries and collisions over time", "x": "t_mid_s", "y": ["mac.retries", "medium.collisions"]}
  ]
}
